<?xml version="1.0" encoding="UTF-8"?>

<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.io7m.primogenitor</groupId>
    <artifactId>com.io7m.primogenitor.lite</artifactId>
    <version>9.1.0</version>
  </parent>

  <groupId>com.io7m.flannel</groupId>
  <artifactId>com.io7m.flannel</artifactId>
  <version>1.0.0-SNAPSHOT</version>

  <packaging>pom</packaging>
  <name>com.io7m.flannel</name>
  <description>Pure Java FLAC</description>
  <url>https://www.github.com/io7m-com/flannel</url>

  <modules>
    <module>com.io7m.flannel.core</module>
    <module>com.io7m.flannel.tests</module>
  </modules>

  <properties>
    <io7m.workID></io7m.workID>
    <checkstyle.skip>true</checkstyle.skip>

    <!-- Configuration. -->
    <io7m.api.previousVersion>1.0.0-SNAPSHOT</io7m.api.previousVersion>
    <io7m.java.targetJavaVersion>17</io7m.java.targetJavaVersion>

    <!-- io7m dependencies. -->

    <!-- Third-party dependencies. -->
    <org.junit.version>5.14.1</org.junit.version>
  </properties>

  <licenses>
    <license>
      <name>LGPL-2.1</name>
      <url>https://www.io7m.com/license/lgpl-2.1.txt</url>
    </license>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.io7m.com/license/apache-2.0.txt</url>
    </license>
  </licenses>

  <scm>
    <url>https://www.github.com/io7m-com/flannel</url>
    <connection>scm:git:https://www.github.com/io7m-com/flannel</connection>
    <developerConnection>scm:git:https://www.github.com/io7m-com/flannel</developerConnection>
  </scm>

  <developers>
    <developer>
      <id>io7m</id>
      <name>io7m</name>
      <email>code@io7m.com</email>
      <url>https://www.io7m.com</url>
    </developer>
  </developers>

  <issueManagement>
    <url>https://www.github.com/io7m-com/flannel/issues</url>
    <system>GitHub Issues</system>
  </issueManagement>

  <distributionManagement>
    <site>
      <id>io7m.com</id>
      <name>io7m.com</name>
      <url>https://www.io7m.com/software/flannel</url>
    </site>
    <snapshotRepository>
      <id>central</id>
      <url>https://central.sonatype.com/repository/maven-snapshots/</url>
    </snapshotRepository>
  </distributionManagement>

  <ciManagement>
    <system>GitHub Actions</system>
    <url>https://github.com/flannel/actions</url>
  </ciManagement>

  <prerequisites>
    <maven>3.0.4</maven>
  </prerequisites>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${org.junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>org.osgi</groupId>
        <artifactId>org.osgi.annotation.bundle</artifactId>
        <version>2.0.0</version>
      </dependency>
      <dependency>
        <groupId>org.osgi</groupId>
        <artifactId>org.osgi.annotation.versioning</artifactId>
        <version>1.1.2</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

</project>